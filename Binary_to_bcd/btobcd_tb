module binary_to_bcd_tb();

reg [3:0] binary;
wire [7:0] bcd;

binary_to_bcd dut(
    .binary(binary),
    .bcd(bcd)
);

integer k;

initial begin
    $dumpfile("binary_to_bcd.vcd");
    $dumpvars(0, binary_to_bcd_tb);

    $monitor("Binary=%d BCD=%b", binary, bcd);

    for (k = 0; k < 16; k = k + 1) begin
        binary = k;
        #5;
    end

    $finish;
end

endmodule
