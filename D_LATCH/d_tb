module d_latch_tb();

reg d;
reg en;
wire q;
wire qbar;

d_latch dut(
    .d(d),
    .en(en),
    .q(q),
    .qbar(qbar)
);

initial begin 
    $dumpfile("d_latch");
    $dumpvars(0,d_latch_tb);
    $monitor("d=%b,en=%b,q=%b,qbar=%b",d,en,q,qbar);

    en=1;d=0;
    #10;
    en=1;d=1;
    #10;
    en=0;d=0;
    #10;
    en=0;d=1;
    #10;

    $finish;

end
endmodule
