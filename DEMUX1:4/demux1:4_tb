module demux4_tb();

reg i;
reg s0,s1;
wire y0, y1,y2,y3;

demux4 dut(
    .i(i),
    .s0(s0),
    .s1(s1),
    .y0(y0),
    .y1(y1),
    .y2(y2),
    .y3(y3)
);

integer a;

initial begin

    $dumpfile("demux4.vcd");
    $dumpvars(0, demux4_tb);

    $monitor("i=%b, s0=%b,s1=%b, y0=%b, y1=%b,y2=%b,y3=%b,", i, s0,s1, y0, y1,y2,y3);

    for(a=0; a<8; a=a+1) begin
        {i,s1,s0} = a;
        #5;
    end

    $finish;

end

endmodule
