module logic_unit_tb();

reg [3:0] a,b;
reg [2:0] sel;
wire [3:0] y;

logic_unit dut(
    .a(a),
    .b(b),
    .sel(sel),
    .y(y)
);

integer k;

initial begin
    $dumpfile("logic_unit.vcd");
    $dumpvars(0, logic_unit_tb);

    a = 4'b1010;
    b = 4'b0011;

    $monitor("a=%b b=%b sel=%b y=%b", a,b,sel,y);

    for(k=0;k<8;k=k+1) begin
        sel = k;
        #5;
    end

    $finish;
end

endmodule
