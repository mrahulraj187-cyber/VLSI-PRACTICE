module parity_checker_tb();

reg [3:0] a;
reg mode;
wire error;

parity_checker dut(
    .a(a),
    .mode(mode),
    .error(error)
);

integer k;

initial begin
    $dumpfile("parity_checker.vcd");
    $dumpvars(0, parity_checker_tb);

    $monitor("a=%b, mode=%b, error=%b", a, mode, error);

    // Even parity
    mode = 0;
    for(k=0; k<16; k=k+1) begin
        a = k;
        #5;
    end

    // Odd parity
    mode = 1;
    for(k=0; k<16; k=k+1) begin
        a = k;
        #5;
    end

    $finish;
end

endmodule
