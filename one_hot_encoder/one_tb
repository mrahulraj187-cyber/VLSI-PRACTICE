module one_hot_encoder_tb();

reg [15:0] a;
wire [3:0] y;

one_hot_encoder dut(
    .a(a),
    .y(y)
);

integer k;

initial begin
    $dumpfile("one_hot_encoder.vcd");
    $dumpvars(0, one_hot_encoder_tb);

    $monitor("a=%b y=%b", a, y);

    for(k=0; k<16; k=k+1) begin
        a = 16'b1 << k;
        #5;
    end

    $finish;
end

endmodule
