module jk_flip_flop_tb();

reg j, k, clk;
wire q, qbar;

jk_flip_flop dut(
    .j(j),
    .k(k),
    .clk(clk),
    .q(q),
    .qbar(qbar)
);

initial begin
    $dumpfile("jk_flip_flop.vcd");
    $dumpvars(0, jk_flip_flop_tb);

    $monitor("j=%b k=%b clk=%b q=%b qbar=%b",
             j, k, clk, q, qbar);

    clk = 0;

    // Hold
    j = 0; k = 0;
    #10;

    // Set
    j = 1; k = 0;
    #10;

    // Reset
    j = 0; k = 1;
    #10;

    // Toggle
    j = 1; k = 1;
    #20;

    $finish;
end

always #5 clk = ~clk;

endmodule
