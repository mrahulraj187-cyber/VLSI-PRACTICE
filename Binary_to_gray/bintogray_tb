module binary_to_gray_tb();

reg [3:0] b;
wire [3:0] g;

binary_to_gray dut(
    .b(b),
    .g(g)
);

integer k;

initial begin
    $dumpfile("binary_to_gray.vcd");
    $dumpvars(0,binary_to_gray_tb);

    $monitor("Binary=%b Gray=%b",b,g);

    for(k=0;k<16;k=k+1) begin
        b=k;
        #5;
    end

    $finish;
end

endmodule
