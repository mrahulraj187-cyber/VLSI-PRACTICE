module bcd_to_binary_tb();

reg [7:0] bcd;
wire [7:0] binary;

bcd_to_binary dut(
    .bcd(bcd),
    .binary(binary)
);

integer k;

initial begin
    $dumpfile("bcd_to_binary.vcd");
    $dumpvars(0, bcd_to_binary_tb);

    $monitor("BCD=%b Binary=%d", bcd, binary);

    for (k = 0; k < 100; k = k + 1) begin
        bcd = ((k / 10) << 4) | (k % 10);
        #5;
    end

    $finish;
end

endmodule
