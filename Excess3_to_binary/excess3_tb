module excess3_to_binary_tb();

reg [3:0] excess3;
wire [3:0] binary;

excess3_to_binary dut(
    .excess3(excess3),
    .binary(binary)
);

integer k;

initial begin
    $dumpfile("excess3_to_binary.vcd");
    $dumpvars(0, excess3_to_binary_tb);

    $monitor("Excess3=%b Binary=%b", excess3, binary);

    for(k=3; k<=12; k=k+1) begin
        excess3 = k;
        #5;
    end

    $finish;
end

endmodule
