module parity_generator_tb();
reg [3:0]a;
reg mode;
wire parity;

parity_generator dut(
    .a(a),
    .mode(mode),
    .parity(parity)
);

integer k;

initial begin
    $dumpfile("parity_generator.vcd");
    $dumpvars(0,parity_generator_tb);
    $monitor("a=%b,mode=%b,parity=%b",a,mode,parity);
    
    mode=0;
    for(k=0;k<16;k=k+1)begin
        a=k;
        #5;
    end

    mode=1;
    for(k=0;k<16;k=k+1)begin
        a=k;
        #5;
    end

    $finish;
end
endmodule
