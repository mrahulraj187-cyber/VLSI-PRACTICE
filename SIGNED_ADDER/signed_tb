module signed_adder_tb();

reg signed [3:0] a;
reg signed [3:0] b;
wire signed [4:0] sum;

signed_adder dut(
    .a(a),
    .b(b),
    .sum(sum)
);

integer k;

initial begin
    $dumpfile("signed_adder.vcd");
    $dumpvars(0, signed_adder_tb);
    $monitor("a=%b, b=%b, sum=%b", a, b, sum);

    for(k=-8; k<8; k=k+1) begin
        a = k;
        b = -k;
        #5;
    end

    $finish;
end

endmodule
