module d_flip_flop_tb();

reg d, clk;
wire q, qbar;

d_flip_flop dut(
    .d(d),
    .clk(clk),
    .q(q),
    .qbar(qbar)
);

initial begin
    $dumpfile("d_flip_flop.vcd");
    $dumpvars(0, d_flip_flop_tb);

    $monitor("d=%b clk=%b q=%b qbar=%b", d,clk,q,qbar);

    clk = 0;
    d = 0;

    #5 d = 1;
    #5 d = 0;
    #5 d = 1;
    #5 d = 0;

    #10 $finish;
end

always #2 clk = ~clk;

endmodule
