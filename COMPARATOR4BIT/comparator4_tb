module comparator4_tb();

reg [3:0] a;
reg [3:0] b;
wire gt;
wire eq;
wire lt;

comparator4 dut(
    .a(a),
    .b(b),
    .gt(gt),
    .eq(eq),
    .lt(lt)
);

integer x, y;

initial begin

    $dumpfile("comparator4.vcd");
    $dumpvars(0, comparator4_tb);

    $monitor("a=%b,b=%b,gt=%b,eq=%b,lt=%b", a,b,gt,eq,lt);

    for(x=0; x<16; x=x+1) begin
        for(y=0; y<16; y=y+1) begin
            a=x;
            b=y;
            #5;
        end
    end

    $finish;

end

endmodule
