module shift_register_tb();

reg serial_in, clk;
wire [3:0] q;

shift_register dut(
    .serial_in(serial_in),
    .clk(clk),
    .q(q)
);

initial begin
    $dumpfile("shift_register.vcd");
    $dumpvars(0, shift_register_tb);
    $monitor("serial_in=%b clk=%b q=%b",
             serial_in, clk, q);

    clk = 0;
    serial_in = 1;
    #10 serial_in = 0;
    #10 serial_in = 1;
    #10 serial_in = 1;
    #10 serial_in = 0;
    #10 $finish;
end

always #5 clk = ~clk;

endmodule
