module siso_tb();

reg serial_in, clk;
wire serial_out;

siso dut(
    .serial_in(serial_in),
    .clk(clk),
    .serial_out(serial_out)
);

initial begin
    $dumpfile("siso.vcd");
    $dumpvars(0, siso_tb);
    $monitor("serial_in=%b clk=%b serial_out=%b",
             serial_in, clk, serial_out);

    clk = 0;
    serial_in = 1; #10;
    serial_in = 0; #10;
    serial_in = 1; #10;
    serial_in = 1; #10;
    serial_in = 0; #10;
    serial_in = 0; #10;
    $finish;
end

always #5 clk = ~clk;

endmodule
