module sipo_tb();

reg serial_in, clk;
wire [3:0] q;

sipo dut(
    .serial_in(serial_in),
    .clk(clk),
    .q(q)
);

initial begin
    $dumpfile("sipo.vcd");
    $dumpvars(0, sipo_tb);
    $monitor("serial_in=%b clk=%b q=%b",
             serial_in, clk, q);

    clk = 0;
    serial_in = 1; #10;
    serial_in = 0; #10;
    serial_in = 1; #10;
    serial_in = 1; #10;
    $finish;
end

always #5 clk = ~clk;

endmodule
