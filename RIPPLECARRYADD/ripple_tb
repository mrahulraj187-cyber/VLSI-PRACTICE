module ripplecarry_tb();

reg [3:0] a, b;
reg cin;
wire [3:0] sum;
wire carry;

ripplecarry dut(
    .a(a),
    .b(b),
    .cin(cin),
    .sum(sum),
    .carry(carry)
);

initial begin
    $dumpfile("ripplecarry.vcd");
    $dumpvars(0, ripplecarry_tb);

    $monitor("a=%b, b=%b, cin=%b, sum=%b, carry=%b",
             a, b, cin, sum, carry);

    a=4'b0000; b=4'b0000; cin=0;
    #5;

    a=4'b0000; b=4'b0000; cin=1;
    #5;

    a=4'b0000; b=4'b0001; cin=0;
    #5;

    a=4'b0000; b=4'b0001; cin=1;
    #5;

    a=4'b0001; b=4'b0000; cin=0;
    #5;

    a=4'b0001; b=4'b0000; cin=1;
    #5;

    a=4'b0001; b=4'b0001; cin=0;
    #5;

    a=4'b0001; b=4'b0001; cin=1;
    #5;

    $finish;
end

endmodule
